---
import { UI } from "../config/ui-strings";
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const label = UI.darkModeToggle[lang as "pl" | "en"] ?? UI.darkModeToggle.en;
---

<button id="theme-toggle" class="theme-toggle" aria-label={label} type="button">
  <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--transition);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
  .icon-moon {
    display: none;
  }
  [data-theme="dark"] .icon-sun {
    display: none;
  }
  [data-theme="dark"] .icon-moon {
    display: block;
  }
</style>

<script is:inline>
  // Runs synchronously before paint to avoid a light/dark flash — see the
  // matching blocking script in BaseLayout's <head>.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    localStorage.setItem("heyid-theme", next);
  });
</script>
