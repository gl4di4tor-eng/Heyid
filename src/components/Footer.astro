---
import { SITE } from "../config/site";
import { FOOTER_NAV } from "../config/navigation";
import { UI } from "../config/ui-strings";
import { localePath } from "../lib/paths";
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const l = lang as "pl" | "en";
const year = new Date().getFullYear();
const LAUNCHNEST_BADGE = `<a href="https://launch-nest-ai.base44.app/products/6a9d47cffe7d53d0aede108d?ref=badge&from=heyid.online" target="_blank" rel="noopener" style="font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;display:inline-flex;flex-direction:column;gap:2px;padding:8px 14px;border-radius:10px;line-height:1;white-space:nowrap;text-decoration:none;background:#0F172A;border:1px solid rgba(255,255,255,0.08);"><span style="display:inline-flex;align-items:center;gap:5px;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0"><path d="M13.5 1.5L4.5 10.5L1.5 12L4.5 13.5L13.5 22.5L16.5 19.5L9 12L16.5 4.5L13.5 1.5Z" fill="#5B5CFF"/><circle cx="12" cy="8" r="2" fill="#5B5CFF" opacity="0.9"/></svg><span style="font-size:9px;font-weight:700;letter-spacing:1.2px;color:rgba(255,255,255,0.7);opacity:0.85;">LAUNCHED ON</span></span><span style="display:inline-flex;align-items:center;gap:6px;"><span style="font-size:16px;font-weight:700;color:white;letter-spacing:-0.02em;">LaunchNest</span><span style="font-size:9px;font-weight:700;background:rgba(91,92,255,0.25);color:#a5a6ff;padding:2px 5px;border-radius:4px;line-height:1;letter-spacing:0.5px;">LN</span></span></a><img src="https://launch-nest-ai.base44.app/functions/badgePixel?pid=6a9d47cffe7d53d0aede108d" alt="" width="1" height="1" style="position:absolute;opacity:0;pointer-events:none;" aria-hidden="true" />`;
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <div class="brand">
        <img src={`${SITE.base}logo.png`} alt={SITE.name} width="28" height="28" />
        <span>{SITE.name}</span>
      </div>
      <p>{UI.footerTagline[l]}</p>
    </div>
    {Object.values(FOOTER_NAV).map((group) => (
      <div class="col">
        <h3>{group.title[l] ?? group.title.pl}</h3>
        <ul>
          {group.links.map((link) => (
            <li>
              <a href={localePath(lang, link.href)}>{link.label[l] ?? link.label.en}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="container bottom">
    <span>&copy; {year} {SITE.name}</span>
    <div class="launchnest-badge" set:html={LAUNCHNEST_BADGE} />
  </div>
</footer>
<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-24);
    padding-block: var(--space-16) var(--space-8);
    background: var(--bg-sunken);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-8);
  }
  .about .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }
  .about .brand img {
    border-radius: 6px;
  }
  .about p {
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 32ch;
  }
  h3 {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  ul a {
    text-decoration: none;
    color: var(--text);
    font-size: var(--text-sm);
  }
  ul a:hover {
    color: var(--accent);
  }
  .bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--text-xs);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
