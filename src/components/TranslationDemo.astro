
---
import { TRANSLATION_DEMO_NOTE } from "../config/app";
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const l = lang as "pl" | "en";
---
<div class="demo">
  <img
    src="/app-screenshot.webp"
    alt={TRANSLATION_DEMO_NOTE[l]}
    class="phone-screenshot"
    width="360"
    loading="eager"
  />
  <p class="caption">{TRANSLATION_DEMO_NOTE[l]}</p>
</div>
<style>
  .demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .phone-screenshot {
    width: min(360px, 100%);
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--border);
  }
  .caption {
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-align: center;
    max-width: 40ch;
  }
</style>